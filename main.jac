import ".styles.global.css";
import from .components.ui.button { Button }
import from .components.ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }

def _evaluate(app: dict) -> dict {
    completeness = 25; eligibility = 25; budget_score = 25; risk = 25;
    findings: list[str] = [];
    completeness_findings: list[str] = [];
    eligibility_findings: list[str] = [];
    budget_findings: list[str] = [];
    risk_findings: list[str] = [];
    critical = False;
    if not app["constitution"] { completeness -= 8; findings.append("Group constitution is missing"); completeness_findings.append("Group constitution is missing"); if app["type"] == "community_group" or app["type"] == "registered_ngo" { critical = True; } }
    if not app["bank"] { completeness -= 7; findings.append("Verified bank details are missing"); completeness_findings.append("Verified bank details are missing"); }
    if not app["safeguarding"] and app["sensitive"] { completeness -= 5; findings.append("Safeguarding policy is missing"); completeness_findings.append("Safeguarding policy is missing"); }
    if not app["eligible"] { eligibility = 0; findings.append("Category or applicant is outside programme eligibility"); eligibility_findings.append("Category or applicant is outside programme eligibility"); critical = True; }
    if not app["county"] { eligibility -= 8; findings.append("County is required"); eligibility_findings.append("County is required"); }
    if app["amount"] > 500000 { eligibility -= 10; findings.append("Requested amount exceeds the category cap"); eligibility_findings.append("Requested amount exceeds the category cap"); if app["amount"] > 600000 { critical = True; } }
    total = app["budget_total"];
    if total != app["amount"] { budget_score -= 10; findings.append("Budget total does not match amount requested"); budget_findings.append("Budget total does not match amount requested"); }
    if total > 0 and app["largest"] / total > 0.6 { budget_score -= 8; findings.append("One budget item exceeds 60% of the total"); budget_findings.append("One budget item exceeds 60% of the total"); }
    if app["zero_qty"] { budget_score -= 7; findings.append("A budget line has zero quantity"); budget_findings.append("A budget line has zero quantity"); }
    if not app["dates_valid"] { risk -= 15; findings.append("Project end date must follow start date"); risk_findings.append("Project end date must follow start date"); critical = True; }
    if app["duration"] < 7 or app["duration"] > 365 { risk -= 8; findings.append("Project timeline must be 7 to 365 days"); risk_findings.append("Project timeline must be 7 to 365 days"); }
    if not app["safeguarding"] and app["sensitive"] { risk -= 7; risk_findings.append("Safeguarding policy is missing for this project"); }
    score = completeness + eligibility + budget_score + risk;
    rec = "Approve" if score >= 85 else ("Conditional" if score >= 70 else "Reject");
    if critical { rec = "Reject"; }
    elif app["missing_docs_only"] { rec = "Conditional"; }
    if len(findings) == 0 { findings = ["All published checks passed"]; }
    return {"score": score, "completeness": completeness, "eligibility": eligibility, "budget": budget_score, "risk": risk, "findings": findings, "completeness_findings": completeness_findings, "eligibility_findings": eligibility_findings, "budget_findings": budget_findings, "risk_findings": risk_findings, "recommendation": rec};
}

def:pub app() -> JsxElement {
    has selected: int = 0;
    has role: str = "Reviewer";
    has page: str = "Overview";
    has reviewed: bool = False;
    has report_open: bool = False;
    has reviewer_decision: str = "";
    has form_open: bool = False;
    has applicant: str = ""; has organization: str = ""; has project: str = ""; has county: str = ""; has category: str = "Education"; has amount: str = ""; has summary: str = ""; has error_message: str = "";
    has audit: list[str] = [];
    def lines(items: list[str]) -> str {
        output = "";
        for item in items { output += "• " + item + "\n"; }
        return output if output else "• No additional findings";
    }
    has apps: list[dict] = [
        {"applicant":"Amina Wanjiku", "organization":"Tumaini Youth Learning", "project":"Digital learning kits for rural classrooms", "county":"Nairobi", "category":"Education", "type":"registered_ngo", "amount":420000.0, "summary":"Shared tablets, offline content and teacher orientation for three community classrooms.", "constitution":True, "bank":True, "safeguarding":True, "sensitive":True, "eligible":True, "budget_total":420000.0, "largest":210000.0, "zero_qty":False, "dates_valid":True, "duration":150, "critical":False, "missing_docs_only":False, "status":"Under review"},
        {"applicant":"Peter Odhiambo", "organization":"Kisumu Community Gardeners", "project":"Community kitchen garden starter", "county":"Kisumu", "category":"community_group", "type":"community_group", "amount":180000.0, "summary":"Shared vegetable beds and practical growing sessions for local households.", "constitution":False, "bank":False, "safeguarding":True, "sensitive":False, "eligible":True, "budget_total":180000.0, "largest":70000.0, "zero_qty":False, "dates_valid":True, "duration":97, "critical":False, "missing_docs_only":True, "status":"Submitted"},
        {"applicant":"Brian Kibet", "organization":"Nakuru Youth Makers", "project":"Youth repair workshop", "county":"Nakuru", "category":"Youth", "amount":300000.0, "summary":"Youth bicycle repair workshop with practical skills training.", "constitution":True, "bank":True, "safeguarding":False, "sensitive":True, "eligible":True, "budget_total":275000.0, "largest":220000.0, "zero_qty":True, "dates_valid":False, "duration":-8, "critical":True, "status":"Submitted"}
    ];
    def clear_detail() { reviewed = False; report_open = False; reviewer_decision = ""; audit = []; }
    def select_a(e: MouseEvent) { selected = 0; clear_detail(); }
    def select_b(e: MouseEvent) { selected = 1; clear_detail(); }
    def select_c(e: MouseEvent) { selected = 2; clear_detail(); }
    def run_review(e: MouseEvent) { reviewed = True; report_open = False; result = _evaluate(apps[selected]); audit = audit + ["Four deterministic agents completed for " + apps[selected]["project"]]; }
    def approve(e: MouseEvent) { reviewer_decision = "Approved"; apps = apps[:selected] + [{**apps[selected], "status":"Approved"}] + apps[selected + 1:]; }
    def conditional(e: MouseEvent) { reviewer_decision = "Approved with Conditions"; apps = apps[:selected] + [{**apps[selected], "status":"Conditional"}] + apps[selected + 1:]; }
    def reject(e: MouseEvent) { reviewer_decision = "Rejected"; apps = apps[:selected] + [{**apps[selected], "status":"Rejected"}] + apps[selected + 1:]; }
    def open_report(e: MouseEvent) { report_open = True; }
    def reset(e: MouseEvent) { apps = [{"applicant":"Amina Wanjiku", "organization":"Tumaini Youth Learning", "project":"Digital learning kits for rural classrooms", "county":"Nairobi", "category":"Education", "type":"registered_ngo", "amount":420000.0, "summary":"Shared tablets, offline content and teacher orientation for three community classrooms.", "constitution":True, "bank":True, "safeguarding":True, "sensitive":True, "eligible":True, "budget_total":420000.0, "largest":210000.0, "zero_qty":False, "dates_valid":True, "duration":150, "critical":False, "missing_docs_only":False, "status":"Under review"}, {"applicant":"Peter Odhiambo", "organization":"Kisumu Community Gardeners", "project":"Community kitchen garden starter", "county":"Kisumu", "category":"community_group", "type":"community_group", "amount":180000.0, "summary":"Shared vegetable beds and practical growing sessions for local households.", "constitution":False, "bank":False, "safeguarding":True, "sensitive":False, "eligible":True, "budget_total":180000.0, "largest":70000.0, "zero_qty":False, "dates_valid":True, "duration":97, "critical":False, "missing_docs_only":True, "status":"Submitted"}, {"applicant":"Brian Kibet", "organization":"Nakuru Youth Makers", "project":"Youth repair workshop", "county":"Nakuru", "category":"Youth", "amount":300000.0, "summary":"Youth bicycle repair workshop with practical skills training.", "constitution":True, "bank":True, "safeguarding":False, "sensitive":True, "eligible":True, "budget_total":275000.0, "largest":220000.0, "zero_qty":True, "dates_valid":False, "duration":-8, "critical":True, "status":"Submitted"}]; selected = 0; role = "Reviewer"; page = "Overview"; form_open = False; clear_detail(); }
    def switch_role(e: MouseEvent) { role = "Applicant" if role == "Reviewer" else "Reviewer"; }
    def go_overview(e: MouseEvent) { page = "Overview"; form_open = False; }
    def go_apps(e: MouseEvent) { page = "Applications"; form_open = False; }
    def go_rules(e: MouseEvent) { page = "Rules & guide"; form_open = False; }
    def open_form(e: MouseEvent) { page = "Applications"; form_open = True; error_message = ""; }
    def on_applicant(e: ChangeEvent) { applicant = e.target.value; }
    def on_org(e: ChangeEvent) { organization = e.target.value; }
    def on_project(e: ChangeEvent) { project = e.target.value; }
    def on_county(e: ChangeEvent) { county = e.target.value; }
    def on_amount(e: ChangeEvent) { amount = e.target.value; }
    def on_summary(e: ChangeEvent) { summary = e.target.value; }
    def submit(e: MouseEvent) {
        if not applicant or not organization or not project or not county or not amount or not summary { error_message = "Please complete all required fields."; }
        else {
            val = float(amount);
            added = {"applicant":applicant, "organization":organization, "project":project, "county":county, "category":category, "type":"student_group", "amount":val, "summary":summary, "constitution":True, "bank":True, "safeguarding":True, "sensitive":category == "Education" or category == "Youth" or category == "Health", "eligible":val <= 500000, "budget_total":val, "largest":val, "zero_qty":False, "dates_valid":True, "duration":90, "critical":False, "missing_docs_only":False, "status":"Under review"};
            apps = apps + [added]; selected = len(apps) - 1; reviewed = True; report_open = False; reviewer_decision = ""; audit = ["Application submitted", "Four deterministic agents completed"];
            form_open = False; error_message = ""; applicant = ""; organization = ""; project = ""; county = ""; amount = ""; summary = "";
        }
    }
    current = apps[selected]; result = _evaluate(current);
    pending = 0; approved_total = 0.0; flagged = 0;
    for record in apps {
        if record["status"] == "Submitted" or record["status"] == "Under review" { pending += 1; }
        if record["status"] == "Approved" { approved_total += record["amount"] as float; }
        check = _evaluate(record);
        if check["completeness"] < 25 or check["eligibility"] < 25 or check["budget"] < 25 or check["risk"] < 25 or record["status"] == "Rejected" or record["status"] == "Conditional" { flagged += 1; }
    }
    return <div className="min-h-screen bg-[#F7F3EA] text-[#1F2937] md:flex">
        <aside className="bg-[#0B3D2E] p-4 text-white md:min-h-screen md:w-64 md:shrink-0 md:p-6"><div className="flex items-center gap-3"><div className="rounded-xl bg-white/10 p-3 font-bold">GF</div><div><h2 className="font-semibold">GrantFlow KE</h2><p className="text-xs text-white/70">Community fund review</p></div></div><nav className="mt-6 flex gap-2 overflow-x-auto md:flex-col"><button onClick={go_overview} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Overview</button><button onClick={go_apps} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Applications</button><button onClick={go_rules} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Rules &amp; guide</button></nav><p className="mt-8 text-xs text-white/70">Demo Mode: deterministic agents active</p></aside>
        <main className="min-w-0 flex-1 p-4 sm:p-7 lg:p-10"><header className="mb-6 flex flex-wrap items-center justify-between gap-4"><div><p className="text-sm text-[#0B3D2E]">Grant review workspace</p><h1 className="text-2xl font-semibold">{page}</h1><p className="text-sm text-slate-600">Published rules, explainable decisions, a complete audit trail.</p></div><div className="flex flex-wrap gap-2"><Button variant="outline" onClick={switch_role}>{role} role</Button><Button variant="outline" onClick={reset}>Reset Demo Data</Button>{if role == "Applicant" {<Button onClick={open_form}>New application</Button>}}</div></header>
        <div className="mb-5 rounded-full border border-emerald-200 bg-white px-4 py-2 text-sm text-[#0B3D2E]">Demo Mode: deterministic agents active</div>
        {if page == "Overview" {<div className="grid grid-cols-2 gap-3 xl:grid-cols-4"><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Applications</p><p className="mt-2 text-3xl font-semibold">{str(len(apps))}</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Pending review</p><p className="mt-2 text-3xl font-semibold">{str(pending)}</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Approved amount</p><p className="mt-2 text-xl font-semibold">KES {str(approved_total)}</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Flagged applications</p><p className="mt-2 text-3xl font-semibold">{str(flagged)}</p></CardContent></Card></div>}}
        {if page == "Rules & guide" {<Card><CardHeader><CardTitle>Published deterministic rules</CardTitle><CardDescription>Every review uses these inputs and checks.</CardDescription></CardHeader><CardContent className="flex flex-col gap-3 text-sm"><p>Completeness: constitution, bank details and safeguarding where applicable.</p><p>Eligibility: programme eligibility and a KES 500,000 request cap.</p><p>Budget: requested total match, largest item at or below 60%, and nonzero quantities.</p><p>Risk: valid dates, 7–365 day timeline and safeguarding for sensitive categories.</p><p>Decision bands: 85–100 approve; 70–84 conditional; below 70 reject. Critical document failure or critical risk may require rejection.</p><p>Demo guide: review Amina, inspect Peter’s missing documents, inspect Brian’s high-risk timeline and budget, then reset to restore the original three cases.</p></CardContent></Card>}}
        {if page == "Applications" {<div className="mb-5"><Card><CardHeader><div className="flex flex-wrap items-center justify-between"><div><CardTitle>Applications</CardTitle><CardDescription>Programme applications and current statuses.</CardDescription></div>{if role == "Applicant" {<Button onClick={open_form}>New application</Button>}}</div></CardHeader><CardContent className="flex flex-col gap-2">{for (i, rec) in enumerate(apps) {<button key={str(i)} onClick={lambda { selected = i; clear_detail(); }} className="grid grid-cols-3 gap-2 rounded-lg border bg-white p-3 text-left text-sm"><span>{rec["project"]}<span className="block text-xs text-slate-500">{rec["applicant"]}</span></span><span>{rec["county"]} · {rec["category"]}</span><span>{rec["status"]}</span></button>}}</CardContent></Card></div>}}
        {if form_open {<Card className="mb-5"><CardHeader><CardTitle>New funding application</CardTitle><CardDescription>All fields are required. A deterministic review runs on submission.</CardDescription></CardHeader><CardContent className="grid gap-3 sm:grid-cols-2"><label>Applicant name<input value={applicant} onChange={on_applicant} className="mt-1 h-10 w-full rounded border bg-white px-3" /></label><label>Organization<input value={organization} onChange={on_org} className="mt-1 h-10 w-full rounded border bg-white px-3" /></label><label>Project title<input value={project} onChange={on_project} className="mt-1 h-10 w-full rounded border bg-white px-3" /></label><label>County<input value={county} onChange={on_county} className="mt-1 h-10 w-full rounded border bg-white px-3" /></label><label>Category<select value={category} onChange={lambda (e: ChangeEvent) { category = e.target.value; }} className="mt-1 h-10 w-full rounded border bg-white px-3"><option>Education</option><option>Youth</option><option>Agriculture</option><option>Health</option><option>Environment</option><option>Women</option><option>Other</option></select></label><label>Requested amount (KES)<input value={amount} onChange={on_amount} type="number" className="mt-1 h-10 w-full rounded border bg-white px-3" /></label><label className="sm:col-span-2">Project summary<textarea value={summary} onChange={on_summary} className="mt-1 min-h-20 w-full rounded border bg-white p-3" /></label><p className="text-sm text-red-700 sm:col-span-2">{error_message}</p><div className="flex gap-2 sm:col-span-2"><Button onClick={submit}>Submit application</Button><Button variant="outline" onClick={lambda { form_open = False; }}>Cancel</Button></div></CardContent></Card>}}
        {if page != "Rules & guide" {<div className="mt-5 grid gap-5 xl:grid-cols-5"><Card className="xl:col-span-2"><CardHeader><CardTitle>Application queue</CardTitle><CardDescription>Select a case to inspect its review.</CardDescription></CardHeader><CardContent className="flex flex-col gap-2">{for (i, rec) in enumerate(apps) {<button key={str(i)} onClick={lambda { selected = i; clear_detail(); }} className="rounded-xl border bg-white p-3 text-left"><p className="font-medium">{rec["project"]}</p><p className="text-xs text-slate-500">{rec["applicant"]} · {rec["county"]}</p></button>}}</CardContent></Card>
        <Card className="xl:col-span-3"><CardHeader><CardTitle>{current["project"]}</CardTitle><CardDescription>{current["organization"]} · {current["county"]} · {current["category"]}</CardDescription></CardHeader><CardContent className="flex flex-col gap-4"><p>{current["summary"]}</p><p className="rounded-lg bg-[#F7F3EA] p-3 text-sm">Applicant {current["applicant"]} · KES {str(current["amount"])} · {current["status"]}</p>{if role == "Reviewer" {<div className="flex flex-wrap gap-2"><Button disabled={bool(reviewer_decision)} onClick={run_review}>Run Review Agents</Button><Button variant="outline" disabled={bool(reviewer_decision)} onClick={approve}>Approve</Button><Button variant="outline" disabled={bool(reviewer_decision)} onClick={conditional}>Approve with Conditions</Button><Button variant="outline" disabled={bool(reviewer_decision)} onClick={reject}>Reject</Button><Button variant="outline" disabled={not reviewed} onClick={open_report}>Generate Report</Button></div>}}<h3 className="font-semibold">Agent results</h3>{if reviewed {<div className="grid gap-2 sm:grid-cols-2"><div className="rounded border bg-white p-3"><b>Completeness · {str(result["completeness"])}/25</b><p>{"; ".join(result["completeness_findings"]) if len(result["completeness_findings"]) > 0 else "All required completeness checks passed"}</p></div><div className="rounded border bg-white p-3"><b>Eligibility · {str(result["eligibility"])}/25</b><p>{lines(result["eligibility_findings"]) if len(result["eligibility_findings"]) > 0 else "Programme eligibility and county checks passed"}</p></div><div className="rounded border bg-white p-3"><b>Budget · {str(result["budget"])}/25</b><p>{lines(result["budget_findings"]) if len(result["budget_findings"]) > 0 else "Budget totals, line size and quantities passed"}</p></div><div className="rounded border bg-white p-3"><b>Risk · {str(result["risk"])}/25</b><p>{lines(result["risk_findings"]) if len(result["risk_findings"]) > 0 else "Timeline and safeguards passed"}</p></div></div>} else {if current["status"] == "Approved" or current["status"] == "Conditional" or current["status"] == "Rejected" {<p className="text-sm">Your application outcome is {current["status"]}.</p>} else {<p className="text-sm text-slate-500">No review has been run for this application.</p>}}}{if reviewed {<div className="rounded border bg-white p-3 text-sm"><p>Final score: {str(result["score"])}/100</p><p>Agent recommendation: {result["recommendation"]}</p><p>Reviewer decision: {reviewer_decision if reviewer_decision else "Not recorded"}</p><p className="whitespace-pre-line">Key findings:\n{lines(result["findings"])}</p></div>}}{if report_open and reviewed {<article className="rounded border border-[#D8D2C4] bg-white p-5 text-sm"><p className="font-semibold text-[#0B3D2E]">GRANTFLOW KE · DECISION REPORT</p><h3 className="my-2 text-lg font-semibold">{current["project"]}</h3><p>Applicant: {current["applicant"]} · Organization: {current["organization"]} · County: {current["county"]}</p><p>Score: {str(result["score"])}/100 · Agent recommendation: {result["recommendation"]}</p><p>Reviewer decision: {reviewer_decision if reviewer_decision else "Not recorded"}</p><p className="whitespace-pre-line">Key findings:\n{lines(result["findings"])}</p><p className="whitespace-pre-line">Conditions:\n{lines(result["completeness_findings"]) if result["recommendation"] == "Conditional" else lines(result["findings"]) if reviewer_decision == "Rejected" else "No additional conditions"}</p><p className="mt-3 text-xs text-slate-500">Prepared from published deterministic rules.</p></article>}}<h3 className="font-semibold">Audit trail</h3>{for (i, entry) in enumerate(audit) {<p key={str(i)} className="border-l-2 border-emerald-600 pl-3 text-sm">{entry}</p>}}</CardContent></Card></div>}}
        </main>
    </div>;
}
