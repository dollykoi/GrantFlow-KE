import ".styles.global.css";
import from .components.ui.button { Button }
import from .components.ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }

def:pub app() -> JsxElement {
    has selected: int = 0;
    has reviewed: bool = False;
    has role: str = "Reviewer";
    has page: str = "Overview";
    def run_review(e: MouseEvent) { reviewed = True; }
    def reset_demo(e: MouseEvent) { selected = 0; reviewed = False; role = "Reviewer"; page = "Overview"; }
    def change_role(e: MouseEvent) { role = "Applicant" if role == "Reviewer" else "Reviewer"; }
    def show_apps(e: MouseEvent) { page = "Applications"; }
    def show_rules(e: MouseEvent) { page = "Rules & guide"; }
    def show_overview(e: MouseEvent) { page = "Overview"; }
    return <div className="min-h-screen bg-[#F7F3EA] text-[#1F2937] md:flex">
        <aside className="bg-[#0B3D2E] p-4 text-white md:min-h-screen md:w-64 md:shrink-0 md:p-6"><div className="flex items-center gap-3"><div className="rounded-xl bg-white/10 p-3 font-bold">GF</div><div><h2 className="font-semibold">GrantFlow KE</h2><p className="text-xs text-white/70">Community fund review</p></div></div><nav className="mt-6 flex gap-2 overflow-auto md:flex-col"><button onClick={show_overview} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Overview</button><button onClick={show_apps} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Applications</button><button onClick={show_rules} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Rules &amp; guide</button></nav><p className="mt-8 text-xs text-white/70">Demo Mode: deterministic agents active</p></aside>
        <main className="min-w-0 flex-1 p-4 sm:p-7 lg:p-10"><header className="mb-6 flex flex-wrap items-center justify-between gap-4"><div><p className="text-sm text-[#0B3D2E]">Grant review workspace</p><h1 className="text-2xl font-semibold">{page}</h1><p className="text-sm text-slate-600">Published rules, explainable decisions, a complete audit trail.</p></div><div className="flex flex-wrap gap-2"><Button variant="outline" onClick={change_role}>{role} role</Button><Button variant="outline" onClick={reset_demo}>Reset Demo Data</Button><Button onClick={show_apps}>New application</Button></div></header>
        <div className="mb-5 rounded-full border border-emerald-200 bg-white px-4 py-2 text-sm text-[#0B3D2E]">Demo Mode: deterministic agents active</div>
        <div className="grid grid-cols-2 gap-3 xl:grid-cols-4"><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Applications</p><p className="mt-2 text-3xl font-semibold">3</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Pending review</p><p className="mt-2 text-3xl font-semibold">3</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Approved amount</p><p className="mt-2 text-xl font-semibold">KES 0</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Flagged applications</p><p className="mt-2 text-3xl font-semibold">1</p></CardContent></Card></div>
        <div className="mt-5 grid gap-5 xl:grid-cols-5"><Card className="xl:col-span-2"><CardHeader><CardTitle>Application queue</CardTitle><CardDescription>Three seeded demo scenarios</CardDescription></CardHeader><CardContent className="flex flex-col gap-2"><button onClick={lambda { selected = 0; reviewed = False; }} className="rounded-xl border bg-white p-3 text-left"><p className="font-medium">Digital learning kits for rural classrooms</p><p className="text-xs text-slate-500">Amina Wanjiku · Nairobi</p></button><button onClick={lambda { selected = 1; reviewed = False; }} className="rounded-xl border bg-white p-3 text-left"><p className="font-medium">Community kitchen garden starter</p><p className="text-xs text-slate-500">Peter Odhiambo · Kisumu</p></button><button onClick={lambda { selected = 2; reviewed = False; }} className="rounded-xl border bg-white p-3 text-left"><p className="font-medium">Youth repair workshop</p><p className="text-xs text-slate-500">Brian Kibet · Nakuru</p></button></CardContent></Card>
        <Card className="xl:col-span-3"><CardHeader><CardTitle>{"Digital learning kits for rural classrooms" if selected == 0 else ("Community kitchen garden starter" if selected == 1 else "Youth repair workshop")}</CardTitle><CardDescription>{"Tumaini Youth Learning · Nairobi" if selected == 0 else ("Kisumu Community Gardeners · Kisumu" if selected == 1 else "Nakuru Youth Makers · Nakuru")}</CardDescription></CardHeader><CardContent className="flex flex-col gap-4"><p className="text-sm leading-relaxed">A community-led project with a practical delivery plan and a clear local benefit.</p><div className="rounded-lg bg-[#F7F3EA] p-3 text-sm">Applicant: {"Amina Wanjiku" if selected == 0 else ("Peter Odhiambo" if selected == 1 else "Brian Kibet")} · Requested KES {"420000" if selected == 0 else ("180000" if selected == 1 else "300000")}</div><div className="flex flex-wrap gap-2"><Button onClick={run_review}>Run Review Agents</Button><Button variant="outline" onClick={lambda { reviewed = True; }}>Approve</Button><Button variant="outline" onClick={lambda { reviewed = True; }}>Approve with Conditions</Button><Button variant="outline" onClick={lambda { reviewed = True; }}>Reject</Button><Button variant="outline" onClick={lambda { reviewed = True; }}>Generate Report</Button></div><h3 className="font-semibold">Agent results</h3><p className="text-sm text-slate-600">{"Four deterministic agents completed · Score " + ("94" if selected == 0 else ("72" if selected == 1 else "38")) + "/100" if reviewed else "Run review agents to see findings and recommendation."}</p><h3 className="font-semibold">Audit trail</h3><p className="border-l-2 border-emerald-600 pl-3 text-sm">{"Four deterministic agents completed · System" if reviewed else "Demo application seeded · System"}</p></CardContent></Card></div>
        </main>
    </div>;
}
