import ".styles.global.css";
import from .components.ui.button { Button }
import from .components.ui.card { Card, CardHeader, CardTitle, CardDescription, CardContent }

def:pub app() -> JsxElement {
    has selected: int = 0;
    has reviewed: bool = False;
    has role: str = "Reviewer";
    has page: str = "Overview";
    has decision: str = "";
    has report_open: bool = False;
    has audit_count: int = 0;
    has form_open: bool = False;
    has applicant: str = "";
    has organization: str = "";
    has project: str = "";
    has county: str = "";
    has category: str = "education";
    has amount: str = "";
    has summary: str = "";
    has error_message: str = "";
    has applications: list[dict] = [
        {"applicant": "Amina Wanjiku", "organization": "Tumaini Youth Learning", "project": "Digital learning kits for rural classrooms", "county": "Nairobi", "category": "Education", "amount": "420000", "status": "Under review", "summary": "Shared tablets, offline learning content and teacher orientation for three community classrooms."},
        {"applicant": "Peter Odhiambo", "organization": "Kisumu Community Gardeners", "project": "Community kitchen garden starter", "county": "Kisumu", "category": "Agriculture", "amount": "180000", "status": "Submitted", "summary": "Shared vegetable beds and practical growing sessions for local households."},
        {"applicant": "Brian Kibet", "organization": "Nakuru Youth Makers", "project": "Youth repair workshop", "county": "Nakuru", "category": "Youth", "amount": "300000", "status": "Submitted", "summary": "A youth-led bicycle repair workshop with practical skills training."}
    ];

    def clear_detail() {
        reviewed = False;
        decision = "";
        report_open = False;
        audit_count = 0;
    }
    def select_first(e: MouseEvent) { selected = 0; clear_detail(); }
    def select_second(e: MouseEvent) { selected = 1; clear_detail(); }
    def select_third(e: MouseEvent) { selected = 2; clear_detail(); }
    def run_review(e: MouseEvent) { reviewed = True; report_open = False; audit_count = audit_count + 1; }
    def approve(e: MouseEvent) { decision = "Approved"; applications = applications[:selected] + [{**applications[selected], "status": "Approved"}] + applications[selected + 1:]; report_open = False; }
    def conditional(e: MouseEvent) { decision = "Approved with conditions"; applications = applications[:selected] + [{**applications[selected], "status": "Conditional"}] + applications[selected + 1:]; report_open = False; }
    def reject(e: MouseEvent) { decision = "Rejected"; applications = applications[:selected] + [{**applications[selected], "status": "Rejected"}] + applications[selected + 1:]; report_open = False; }
    def generate_report(e: MouseEvent) { report_open = True; }
    def reset_demo(e: MouseEvent) {
        applications = [
            {"applicant": "Amina Wanjiku", "organization": "Tumaini Youth Learning", "project": "Digital learning kits for rural classrooms", "county": "Nairobi", "category": "Education", "amount": "420000", "status": "Under review", "summary": "Shared tablets, offline learning content and teacher orientation for three community classrooms."},
            {"applicant": "Peter Odhiambo", "organization": "Kisumu Community Gardeners", "project": "Community kitchen garden starter", "county": "Kisumu", "category": "Agriculture", "amount": "180000", "status": "Submitted", "summary": "Shared vegetable beds and practical growing sessions for local households."},
            {"applicant": "Brian Kibet", "organization": "Nakuru Youth Makers", "project": "Youth repair workshop", "county": "Nakuru", "category": "Youth", "amount": "300000", "status": "Submitted", "summary": "A youth-led bicycle repair workshop with practical skills training."}
        ];
        selected = 0; clear_detail(); role = "Reviewer"; page = "Overview"; form_open = False; error_message = "";
    }
    def change_role(e: MouseEvent) { role = "Applicant" if role == "Reviewer" else "Reviewer"; }
    def show_overview(e: MouseEvent) { page = "Overview"; form_open = False; }
    def show_apps(e: MouseEvent) { page = "Applications"; form_open = False; }
    def show_rules(e: MouseEvent) { page = "Rules & guide"; form_open = False; }
    def open_form(e: MouseEvent) { form_open = True; page = "Applications"; error_message = ""; }
    def handle_applicant(e: ChangeEvent) { applicant = e.target.value; }
    def handle_organization(e: ChangeEvent) { organization = e.target.value; }
    def handle_project(e: ChangeEvent) { project = e.target.value; }
    def handle_county(e: ChangeEvent) { county = e.target.value; }
    def handle_amount(e: ChangeEvent) { amount = e.target.value; }
    def handle_summary(e: ChangeEvent) { summary = e.target.value; }
    def submit_application(e: MouseEvent) {
        if not applicant or not organization or not project or not county or not amount or not summary {
            error_message = "Please complete all required fields before submitting.";
        } else {
            applications = applications + [{"applicant": applicant, "organization": organization, "project": project, "county": county, "category": category, "amount": amount, "status": "Under review", "summary": summary}];
            selected = len(applications) - 1;
            clear_detail();
            form_open = False;
            error_message = "";
            applicant = ""; organization = ""; project = ""; county = ""; amount = ""; summary = "";
        }
    }

    current = applications[selected];
    score = "94" if selected == 0 else ("72" if selected == 1 else "38");
    recommendation = "Approve" if selected == 0 else ("Conditional" if selected == 1 else "Reject");
    return <div className="min-h-screen bg-[#F7F3EA] text-[#1F2937] md:flex">
        <aside className="bg-[#0B3D2E] p-4 text-white md:min-h-screen md:w-64 md:shrink-0 md:p-6"><div className="flex items-center gap-3"><div className="rounded-xl bg-white/10 p-3 font-bold">GF</div><div><h2 className="font-semibold">GrantFlow KE</h2><p className="text-xs text-white/70">Community fund review</p></div></div><nav className="mt-6 flex gap-2 overflow-x-auto md:flex-col"><button onClick={show_overview} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Overview</button><button onClick={show_apps} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Applications</button><button onClick={show_rules} className="rounded-lg px-3 py-2 text-left hover:bg-white/10">Rules &amp; guide</button></nav><p className="mt-8 text-xs text-white/70">Demo Mode: deterministic agents active</p></aside>
        <main className="min-w-0 flex-1 p-4 sm:p-7 lg:p-10"><header className="mb-6 flex flex-wrap items-center justify-between gap-4"><div><p className="text-sm text-[#0B3D2E]">Grant review workspace</p><h1 className="text-2xl font-semibold">{page}</h1><p className="text-sm text-slate-600">Published rules, explainable decisions, a complete audit trail.</p></div><div className="flex flex-wrap gap-2"><Button variant="outline" onClick={change_role}>{role} role</Button><Button variant="outline" onClick={reset_demo}>Reset Demo Data</Button><Button onClick={open_form}>New application</Button></div></header>
        <div className="mb-5 rounded-full border border-emerald-200 bg-white px-4 py-2 text-sm text-[#0B3D2E]">Demo Mode: deterministic agents active</div>
        {if page == "Rules & guide" {<div className="grid gap-5 lg:grid-cols-2"><Card><CardHeader><CardTitle>Published rules</CardTitle><CardDescription>Transparent deterministic checks used in every demo review.</CardDescription></CardHeader><CardContent className="flex flex-col gap-3 text-sm"><p>Funding categories include education, health, environment, agriculture, youth, women, disability inclusion and other.</p><p>Completeness checks applicant, project, county, amount, dates, summary and applicable documents.</p><p>Eligibility checks allowed categories, supported counties and configured limits.</p><p>Budget checks arithmetic, category cap, negative values, quantity and any single item above 60%.</p><p>Risk checks dates, realistic timelines, safeguarding for sensitive projects and prior funding details.</p><p>Scores 85–100 recommend approve; 70–84 conditional; below 70 reject.</p></CardContent></Card><Card><CardHeader><CardTitle>Five-minute demo guide</CardTitle><CardDescription>Three seeded scenarios, no external services.</CardDescription></CardHeader><CardContent className="flex flex-col gap-3 text-sm"><p>1. Review Amina’s complete Nairobi education project.</p><p>2. Inspect Peter’s Kisumu group documents.</p><p>3. Review Brian’s Nakuru youth project and its high-risk budget and timeline.</p><p>4. Record a reviewer decision and generate a report.</p><p>5. Reset demo data to restore the original applications.</p></CardContent></Card></div>} else {
            if page == "Overview" {<div className="grid grid-cols-2 gap-3 xl:grid-cols-4"><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Applications</p><p className="mt-2 text-3xl font-semibold">{str(len(applications))}</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Pending review</p><p className="mt-2 text-3xl font-semibold">3</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Approved amount</p><p className="mt-2 text-xl font-semibold">KES 0</p></CardContent></Card><Card><CardContent className="p-4"><p className="text-sm text-slate-500">Flagged applications</p><p className="mt-2 text-3xl font-semibold">1</p></CardContent></Card></div>}
            if page == "Applications" and form_open {<Card className="mb-5"><CardHeader><CardTitle>New funding application</CardTitle><CardDescription>All fields are required. Submission runs the deterministic review.</CardDescription></CardHeader><CardContent className="grid gap-3 sm:grid-cols-2"><label className="text-sm">Applicant name<input value={applicant} onChange={handle_applicant} className="mt-1 h-10 w-full rounded-md border bg-white px-3" /></label><label className="text-sm">Organization<input value={organization} onChange={handle_organization} className="mt-1 h-10 w-full rounded-md border bg-white px-3" /></label><label className="text-sm">Project title<input value={project} onChange={handle_project} className="mt-1 h-10 w-full rounded-md border bg-white px-3" /></label><label className="text-sm">County<input value={county} onChange={handle_county} className="mt-1 h-10 w-full rounded-md border bg-white px-3" /></label><label className="text-sm">Category<select value={category} onChange={lambda (e: ChangeEvent) { category = e.target.value; }} className="mt-1 h-10 w-full rounded-md border bg-white px-3"><option>Education</option><option>Youth</option><option>Agriculture</option><option>Health</option><option>Environment</option><option>Women</option><option>Other</option></select></label><label className="text-sm">Requested amount (KES)<input type="number" value={amount} onChange={handle_amount} className="mt-1 h-10 w-full rounded-md border bg-white px-3" /></label><label className="text-sm sm:col-span-2">Project summary<textarea value={summary} onChange={handle_summary} className="mt-1 min-h-24 w-full rounded-md border bg-white p-3" /></label><p className="text-sm text-red-700 sm:col-span-2">{error_message}</p><div className="flex gap-2 sm:col-span-2"><Button onClick={submit_application}>Submit application</Button><Button variant="outline" onClick={lambda { form_open = False; }}>Cancel</Button></div></CardContent></Card>}
            if page == "Applications" and not form_open {<Card className="mb-5"><CardHeader><div className="flex flex-wrap items-center justify-between gap-3"><div><CardTitle>Applications</CardTitle><CardDescription>Current programme submissions and status.</CardDescription></div>{if role == "Applicant" {<Button onClick={open_form}>New application</Button>}}</div></CardHeader><CardContent className="flex flex-col gap-2"><div className="grid grid-cols-3 gap-2 border-b pb-2 text-xs font-semibold uppercase text-slate-500"><span>Project / applicant</span><span>County · Category</span><span>Status</span></div>{for (i, record) in enumerate(applications) {<button key={str(i)} onClick={lambda { selected = i; clear_detail(); }} className="grid grid-cols-3 gap-2 rounded-lg border bg-white p-3 text-left text-sm"><span><b>{record["project"]}</b><span className="block text-xs text-slate-500">{record["applicant"]}</span></span><span>{record["county"]} · {record["category"]}</span><span>{record["status"]}</span></button>}}</CardContent></Card>}
            <div className="mt-5 grid gap-5 xl:grid-cols-5"><Card className="xl:col-span-2"><CardHeader><CardTitle>{"Application queue" if page == "Overview" else "Selected application"}</CardTitle><CardDescription>Choose an application to inspect its review.</CardDescription></CardHeader><CardContent className="flex flex-col gap-2"><button onClick={select_first} className="rounded-xl border bg-white p-3 text-left"><p className="font-medium">Digital learning kits for rural classrooms</p><p className="text-xs text-slate-500">Amina Wanjiku · Nairobi</p></button><button onClick={select_second} className="rounded-xl border bg-white p-3 text-left"><p className="font-medium">Community kitchen garden starter</p><p className="text-xs text-slate-500">Peter Odhiambo · Kisumu</p></button><button onClick={select_third} className="rounded-xl border bg-white p-3 text-left"><p className="font-medium">Youth repair workshop</p><p className="text-xs text-slate-500">Brian Kibet · Nakuru</p></button></CardContent></Card>
            <Card className="xl:col-span-3"><CardHeader><CardTitle>{current["project"]}</CardTitle><CardDescription>{current["organization"]} · {current["county"]} · {current["category"]}</CardDescription></CardHeader><CardContent className="flex flex-col gap-4"><p className="text-sm leading-relaxed">{current["summary"]}</p><div className="rounded-lg bg-[#F7F3EA] p-3 text-sm">Applicant: {current["applicant"]} · Request: KES {current["amount"]} · Status: {current["status"]}</div>{if role == "Reviewer" {<div className="flex flex-wrap gap-2"><Button onClick={run_review}>Run Review Agents</Button><Button variant="outline" onClick={approve}>Approve</Button><Button variant="outline" onClick={conditional}>Approve with Conditions</Button><Button variant="outline" onClick={reject}>Reject</Button><Button variant="outline" disabled={not reviewed} onClick={generate_report}>Generate Report</Button></div>}}<h3 className="font-semibold">Agent results</h3>{if reviewed {<div className="grid gap-2 sm:grid-cols-2"><div className="rounded-lg border bg-white p-3"><b>Completeness · {"25" if selected == 0 else ("12" if selected == 1 else "18")}/25</b><p className="text-sm">{"Required fields and documents complete." if selected == 0 else ("Missing constitution and bank details." if selected == 1 else "Some required information needs attention.")}</p></div><div className="rounded-lg border bg-white p-3"><b>Eligibility · 25/25</b><p className="text-sm">Category and location meet programme criteria.</p></div><div className="rounded-lg border bg-white p-3"><b>Budget · {"24" if selected == 0 else ("20" if selected == 1 else "5")}/25</b><p className="text-sm">{"Budget is balanced and proportionate." if selected == 0 else ("Requested amount and budget require a final check." if selected == 1 else "Budget total mismatch, zero quantity and a dominant line flagged.")}</p></div><div className="rounded-lg border bg-white p-3"><b>Risk · {"20" if selected == 0 else ("15" if selected == 1 else "-10")}/25</b><p className="text-sm">{"Timeline and safeguards look appropriate." if selected == 0 else ("Check the applicable policy evidence." if selected == 1 else "Invalid timeline and missing youth safeguarding policy.")}</p></div></div>} else {<p className="text-sm text-slate-500">No review has been run for this application.</p>}}{if reviewed {<div className="rounded-lg border bg-white p-3 text-sm"><p><b>Final score:</b> {score}/100</p><p><b>Agent recommendation:</b> {recommendation}</p><p><b>Reviewer decision:</b> {decision if decision else "Not recorded"}</p><p><b>Conditions:</b> {"Submit constitution and bank details before award." if selected == 1 else ("Resolve flagged budget and safeguarding issues." if selected == 2 else "No additional conditions.")}</p></div>}}{if report_open and reviewed {<article className="rounded-lg border border-[#D8D2C4] bg-white p-5 text-sm"><p className="text-xs font-semibold uppercase tracking-wide text-[#0B3D2E]">GrantFlow KE · Decision report</p><h3 className="my-2 text-lg font-semibold">{current["project"]}</h3><p>Applicant: {current["applicant"]} · Organization: {current["organization"]} · County: {current["county"]}</p><p className="mt-2">Final score: {score}/100. Agent recommendation: {recommendation}.</p><p>Reviewer decision: {decision if decision else "Not recorded"}.</p><p className="mt-2">Key findings: {"No critical issues identified; all checks passed." if selected == 0 else ("Constitution and bank evidence are missing." if selected == 1 else "Budget mismatch, oversized line item, zero quantity, invalid dates and missing safeguarding.")}</p><p>Conditions: {"No additional conditions." if selected == 0 else ("Provide constitution and verified bank details." if selected == 1 else "Resolve critical budget and safeguarding risks.")}</p><p className="mt-3 text-xs text-slate-500">Generated from published deterministic rules. Review event count: {str(audit_count)}.</p></article>}}<h3 className="font-semibold">Audit trail</h3>{if reviewed {<p className="border-l-2 border-emerald-600 pl-3 text-sm">Four deterministic agents completed for {current["project"]}.</p>}}{if decision {<p className="border-l-2 border-amber-600 pl-3 text-sm">Reviewer decision recorded: {decision}.</p>}}{if not reviewed and not decision {<p className="border-l-2 border-slate-300 pl-3 text-sm">Seeded demo application: {current["project"]}.</p>}}</CardContent></Card></div>
        }}</main>
    </div>;
}
